{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_report", "verdict", "repair_hints"],
  "properties": {
    "verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "critical_errors", "gaps"],
      "properties": {
        "summary": {"type": "string"},
        "critical_errors": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "gaps": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "verdict": {"enum": ["correct", "wrong"]},
    "repair_hints": {"type": "string"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "issue"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "correct"}}},
      "then": {
        "properties": {
          "repair_hints": {"const": ""},
          "verification_report": {
            "properties": {
              "critical_errors": {"maxItems": 0},
              "gaps": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "wrong"}}},
      "then": {
        "properties": {
          "repair_hints": {"pattern": "\\S"}
        },
        "anyOf": [
          {
            "properties": {
              "verification_report": {
                "properties": {"critical_errors": {"minItems": 1}}
              }
            }
          },
          {
            "properties": {
              "verification_report": {
                "properties": {"gaps": {"minItems": 1}}
              }
            }
          }
        ]
      }
    }
  ]
}
