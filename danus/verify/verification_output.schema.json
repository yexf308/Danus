{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_schema_version",
    "verification_status",
    "verification_report",
    "verdict",
    "needs_expanded_proofs",
    "repair_hints"
  ],
  "properties": {
    "output_schema_version": {"type": "integer", "enum": [2]},
    "verification_status": {"type": "string", "enum": ["final", "needs_context"]},
    "verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "critical_errors", "gaps"],
      "properties": {
        "summary": {"type": "string"},
        "critical_errors": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "gaps": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "verdict": {"type": "string", "enum": ["correct", "wrong"]},
    "needs_expanded_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "repair_hints": {"type": "string"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "issue"],
      "properties": {
        "location": {"type": "string"},
        "issue": {"type": "string"}
      }
    }
  }
}
